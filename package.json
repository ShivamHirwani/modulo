{
  "name": "modulo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --env-file=.env src/server.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/server.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "smoke": "node --experimental-strip-types src/smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.0.0",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.0",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.9.35",
    "smtp-server": "^3.19.17",
    "typescript": "^5.6.0"
  }
