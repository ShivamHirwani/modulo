# ---- Local development (copy to .env) ----
DATABASE_URL=postgres://modulo_app:change-me@localhost:5432/modulo
PORT=3000
CORS_ORIGINS=http://localhost:8080

# ---- Production / hosted (set in the host's dashboard, never commit) ----
# MIGRATE_DATABASE_URL=postgres://OWNER:pw@host/db        owner role, DIRECT (not pooled) connection; used only by `npm run migrate`
# APP_DB_PASSWORD=<16+ random chars>                       password for the limited modulo_app role the API uses
# DATABASE_URL=postgres://modulo_app:<that password>@<pooled host>/db?sslmode=require
# CORS_ORIGINS=https://your-demo-site.example             comma separated, exact origins that may call the API from a browser
# TRUST_PROXY=true                                         true on Render/Cloudflare/Vercel proxies. false if the API is exposed directly
# NODE_ENV=production
# DEMO_MODE=true                                           allows FAKE payments in production. Remove when Razorpay keys are set
# DB_POOL_MAX=10

# ---- Email. Without SMTP_URL, emails are only logged ----
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=noreply@mail.yourdomain.com                    must be on a domain you own with SPF, DKIM, DMARC

# ---- Payments. Empty = fake provider (no money moves) ----
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# ---- PDF fonts (optional): Noto Sans for rupee sign, Noto Sans Gujarati/Devanagari for those scripts ----
# PDF_FONT_REGULAR=/path/NotoSans-Regular.ttf
# PDF_FONT_BOLD=/path/NotoSans-Bold.ttf
